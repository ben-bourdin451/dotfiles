#!/usr/bin/env bash
# Generates and caches a GitHub App installation token.
# Tokens are cached for 50 minutes (they expire after 60).
set -euo pipefail

APP_ID="${GH_APP_ID:?Set GH_APP_ID}"
PEM_FILE="${GH_APP_PEM:-$HOME/.config/gh/gh-app.pem}"
ORG="${GH_APP_ORG:?Set GH_APP_ORG}"
CACHE_DIR="$HOME/.config/gh"
TOKEN_FILE="$CACHE_DIR/app-token-cache"
INSTALL_ID_FILE="$CACHE_DIR/app-install-id"

# Return cached token if less than 50 minutes old
if [[ -f "$TOKEN_FILE" ]]; then
    token_age=$(( $(date +%s) - $(stat -f %m "$TOKEN_FILE") ))
    if (( token_age < 3000 )); then
        cat "$TOKEN_FILE"
        exit 0
    fi
fi

if [[ ! -f "$PEM_FILE" ]]; then
    echo "PEM file not found: $PEM_FILE" >&2
    exit 1
fi

# Generate JWT (valid for 10 minutes)
now=$(date +%s)
iat=$(( now - 60 ))
exp=$(( now + 600 ))

header=$(printf '{"alg":"RS256","typ":"JWT"}' | openssl base64 -e -A | tr '+/' '-_' | tr -d '=')
payload=$(printf '{"iat":%d,"exp":%d,"iss":"%s"}' "$iat" "$exp" "$APP_ID" | openssl base64 -e -A | tr '+/' '-_' | tr -d '=')
signature=$(printf '%s.%s' "$header" "$payload" | openssl dgst -sha256 -sign "$PEM_FILE" | openssl base64 -e -A | tr '+/' '-_' | tr -d '=')
jwt="${header}.${payload}.${signature}"

# Get installation ID (cached permanently — only changes if app is reinstalled)
if [[ -f "$INSTALL_ID_FILE" ]]; then
    install_id=$(cat "$INSTALL_ID_FILE")
else
    response=$(curl -sf \
        -H "Authorization: Bearer $jwt" \
        -H "Accept: application/vnd.github+json" \
        "https://api.github.com/orgs/${ORG}/installation") || {
        echo "Failed to query GitHub App installation" >&2
        exit 1
    }
    install_id=$(echo "$response" | jq -r '.id')
    if [[ -z "$install_id" || "$install_id" == "null" ]]; then
        echo "Failed to get installation ID from response: $response" >&2
        exit 1
    fi
    echo "$install_id" > "$INSTALL_ID_FILE"
fi

# Get installation access token
response=$(curl -sf -X POST \
    -H "Authorization: Bearer $jwt" \
    -H "Accept: application/vnd.github+json" \
    "https://api.github.com/app/installations/${install_id}/access_tokens") || {
    echo "Failed to create installation token" >&2
    exit 1
}
token=$(echo "$response" | jq -r '.token')

if [[ -z "$token" || "$token" == "null" ]]; then
    echo "Failed to extract token from response: $response" >&2
    exit 1
fi

# Cache the token
echo -n "$token" > "$TOKEN_FILE"
chmod 600 "$TOKEN_FILE"
echo -n "$token"
