{
  "env": {
    "CLAUDE_CODE_NO_FLICKER": "1"
  },
  "permissions": {
    "allow": [
      "Bash(brew:*)",
      "Bash(cat:*)",
      "Bash(cargo:*)",
      "Bash(chmod:*)",
      "Bash(docker:*)",
      "Bash(npm install:*)",
      "Bash(npm test:*)",
      "Bash(npm run format:*)",
      "Bash(npm run lint:*)",
      "Bash(npm view:*)",
      "Bash(npx cdk diff:*)",
      "Bash(npx cdk synth:*)",
      "Bash(npx tsc:*)",
      "Bash(npx vitest:*)",
      "Bash(make:*)",
      "Bash(find:*)",
      "Bash(gh:*)",
      "Bash(git:*)",
      "Bash(go:*)",
      "Bash(gofmt:*)",
      "Bash(grep:*)",
      "Bash(ls:*)",
      "Bash(rg:*)",
      "Bash(pnpm install)",
      "Bash(pnpm test:*)",
      "Bash(pnpm -w run lint:*)",
      "Bash(sed:*)",
      "Bash(st:*)",
      "Bash(stint:*)",
      "Bash(terraform fmt:*)",
      "Bash(terraform get:*)",
      "Bash(terraform init:*)",
      "Bash(terraform plan:*)",
      "Bash(terraform taint:*)",
      "Bash(terraform validate:*)",
      "Bash(wc:*)",
      "Read(~/.claude/**)",
      "Read(~/.zshrc)",
      "Read(~/workspace/**)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:npmjs.com)",
      "WebFetch(domain:pkg.go.dev)",
      "WebFetch(domain:docs.anthropic.com)"
    ],
    "deny": [],
    "defaultMode": "auto"
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "gopls-lsp@claude-plugins-official": true,
    "rust-analyzer-lsp@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true
  },
  "effortLevel": "high",
  "preferredNotifChannel": "terminal_bell",
  "skipAutoPermissionPrompt": true,
  "skipWorkflowUsageWarning": true
}
