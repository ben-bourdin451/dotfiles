# Copy this file to ".env" and fill in real values. ".env" is gitignored (never committed).
#   cp .env.example .env

ROUTER_HOST=192.168.1.1
ROUTER_ADMIN_USER=admin
ROUTER_ADMIN_PASS=your-router-admin-password

WIFI_SSID=YourNetworkName
WIFI_PASS=your-wifi-passphrase

# Optional:
# HEADLESS=1   # run the browser invisibly (default: visible, so you can watch)
# DRY=1        # dry run — fill + verify + cancel, change nothing
